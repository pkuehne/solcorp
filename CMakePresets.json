{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "base-debug",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "base-release",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "base-release-no-tests",
      "hidden": true,
      "inherits": "base-release",
      "cacheVariables": {
        "SC_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-ccache",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": ["linux-ccache", "base-debug"]
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": ["linux-ccache", "base-release"]
    },
    {
      "name": "linux-release-no-tests",
      "displayName": "Linux Release (no tests)",
      "inherits": ["linux-ccache", "base-release-no-tests"]
    },
    {
      "name": "linux-sanitize",
      "displayName": "Linux Debug with sanitizers",
      "inherits": ["linux-ccache", "base-debug"],
      "cacheVariables": {
        "SC_RUN_SANITIZERS": "ON"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "inherits": "base-debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "inherits": "base-release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-release-no-tests",
      "displayName": "Windows Release (no tests)",
      "inherits": "base-release-no-tests",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ]
}
