Checks: >-
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  portability-*,
  modernize-*,
  -clang-analyzer-deadcode.DeadStores,
  -clang-analyzer-core.StackAddressEscape,
  -performance-enum-size,
  -portability-avoid-pragma-once,
  -modernize-use-trailing-return-type,
WarningsAsErrors: '*'
HeaderFilterRegex: '^.*/solcorp/(src|test)/.*'
FormatStyle: file